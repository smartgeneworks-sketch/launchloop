
# ---------------- Reminders (email + WhatsApp) — see docs/REMINDERS.md ----------------
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL_FROM=LaunchLoop <reminders@applaunchloop.com>
# WHATSAPP_TOKEN=            # permanent System User token with whatsapp_business_messaging
# WHATSAPP_PHONE_NUMBER_ID=  # from Meta → WhatsApp → API Setup
# WHATSAPP_TEMPLATE=launchloop_reminder
# WHATSAPP_TEMPLATE_LANG=en

# --- Accounts (sign-up / sign-in)
# APP_API_TOKEN doubles as the team access code needed to create an account.
# SIGNUP_ALLOWED_EMAILS=you@company.com,@company.com   # these can sign up without the code
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=https://applaunchloop.com/api/auth/google/callback   # optional; defaults to <your address>/api/auth/google/callback
